# Copy this file to .env and fill in the values from your Supabase project.
# .env is gitignored. Never commit real keys.

# Anon key. Public by design — embedded in the bundled JS.
# RLS policies are what protect data; this key alone cannot read another user's rows.
VITE_SUPABASE_URL=https://cjrujymnlphrzkkwqidf.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# ─────────────────────────────────────────────────────────────────────────────
# The following are for local CI / RLS test use only. Never imported by app code.
# In Cloudflare Pages, set ONLY the two VITE_ variables above as environment
# variables. The service key lives ONLY in Supabase Edge Function secrets,
# never in client environments.
# ─────────────────────────────────────────────────────────────────────────────

# Used by supabase/tests/rls.test.mjs to set up and tear down test users.
# Set in GitHub Actions secrets as SUPABASE_SERVICE_KEY.
# SUPABASE_SERVICE_KEY=eyJhbGci...
